@page
@model NewAppWDB.Pages.Students.CreateModel

@{
	ViewData["Title"] = "Register Student";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-12 col-md-8 col-lg-6">
			<div class="card">
				<div class="card-header">
					<h4 class="mb-0">Register Student</h4>
				</div>

				@if (!string.IsNullOrEmpty(Model.SubmissionMessage))
				{
					<div class="alert alert-success">
						@Model.SubmissionMessage
					</div>
				}

				<div class="card-body">
					<form method="post">
						<div class="mb-3">
							<label asp-for="Student.FirstName"class="form-label">First Name</label>
							<input type="text" asp-for="Student.FirstName" class="form-control FirstName" placeholder="Enter your first name"/>
							<span asp-validation-for="Student.FirstName" class="text-danger"></span>
						</div>

						<div class="mb-3">
							<label asp-for="Student.LastName" class="form-label">Last Name</label>
							<input type="text" asp-for="Student.LastName" class="form-control" placeholder="Enter your last name"/>
							<span asp-validation-for="Student.LastName" class="text-danger"></span>
						</div>

						<div class="mb-3">
							<label asp-for="Student.Age" class="form-label">Age</label>
							<input type="number" asp-for="Student.Age" class="form-control" placeholder="Enter your age here"/>
							<span asp-validation-for="Student.Age" class="text-danger"></span>
						</div>

						<div class="mb-3">
							<button type="submit" class="btn btn-success">Register</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


<form id="studentForm" class="mt-4">
    <div class="mb-3">
        <label for="studentNameInput" class="form-label">
            Student Name
        </label>
        <input
            type="text"
            id="studentNameInput"
			name="studentName"
            class="form-control"
            placeholder="Enter student name"
			required
			minlength="3"
			maxlength="30"
        >
    </div>

	<div class="mb-3">
		<label for="studentEmail" class="form-label">
			Student Email
		</label>

		<input
			type="email"
			id="studentEmail"
			name="studentEmail"
			class="form-control"
			placeholder="Enter student email"
			required
		>
	</div>

	<div class="form-check mb-3">
		<input
			type="checkbox"
			id="agreeTerms"
			name="agreeTerms"
			class="form-check-input"
			required
		>
		<label for="agreeTerms" class="form-check-label">
			I agree to the registration terms.
		</label>
	</div>

	<div class="mb-3">
		<label class="form-label">Gender</label>

		<div class="form-check">
			<input type="radio" name="gender" id="male" value="Male" class="form-check-input" required>
			<label for="male" class="form-check-label">Male</label>
		</div>

		<div class="form-check">
			<input type="radio" name="gender" id="female" value="Female" class="form-check-input">
			<label for="female" class="form-check-label">Female</label>
		</div>
	</div>

	<div class="mb-3">
		<label for="stateOfOrigin" class="form-label">
			State of Origin
		</label>

		<select id="stateOfOrigin" class="form-select" name="stateOfOrigin" required>
			<option value="">Select your state</option>
			<option value="Lagos">Lagos</option>
			<option value="Delta">Delta</option>
			<option value="Anambra">Anambra</option>
			<option value="Oyo">Oyo</option>
		</select>
	</div>

    <button type="submit" class="btn btn-primary">
        Register
    </button>
</form>
<p id="registeredName" class="mt-3"></p>

<script type="module" src="~/js/create.js"></script>