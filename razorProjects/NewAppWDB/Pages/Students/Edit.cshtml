@page
@model NewAppWDB.Pages.Students.EditModel

@{
	ViewData["Title"] = "Edit Student";
}

<h1>Edit Student</h1>
@if (Model.Student != null) {
	@* <P>Found Student: @Model.Student.FirstName @Model.Student.LastName, Age: @Model.Student.Age</P> *@
	<form method="post">
		<input type="hidden" name="Student.Id" value="@Model.Student.Id" />

		<div class="mb-3">
			<label class="form-label">First Name</label>
			<input type="text" asp-for="Student.FirstName"
			class="form-control" />
			<span asp-validation-for="Student.FirstName" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label class="form-label">Last Name</label>
			<input type="text" asp-for="Student.LastName"
			class="form-control" />
			<span asp-validation-for="Student.LastName" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label class="form-label">Age</label>
			<input type="text" asp-for="Student.Age"
			class="form-control" />
			<span asp-validation-for="Student.Age" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<button type="submit" class="btn btn-primary">Save Changees</button>
		</div>
	</form>
}