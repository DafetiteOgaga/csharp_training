@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <div class="d-flex justify-content-center">
        <h1 class="display-4" id="myHeading">Welcome to</h1>
        <button class="btn btn-success m-4" id="changeButton">Change</button>
    </div>
    <h3>@Model.ApplicationName</h3>
    <p id="totalRegisteredStudents">Total registered students: @Model.NewRecord.Count</p>
    @if (Model.NewRecord.Count == 0) {
        <p>Oopsy! No Student has been registered yet.</p>
        <a href="/Students/Create">Click here to Register a Student</a>
    } else {
        <table class="table table-striped table-hover table-sm align-middle">
            <thead>
                <tr>
                    <th>S/N</th>
                    <th>ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Age</th>
                    @* <th>Edit</th>
                    <th>Delete</th> *@
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (int i=0;i<Model.NewRecord.Count;i++){
                    <tr>
                        <td>@(i+1)</td>
                        <td>@Model.NewRecord[i].Id</td>
                        <td>@Model.NewRecord[i].FirstName <span class="badge text-bg-success">G</span></td>
                        <td>@Model.NewRecord[i].LastName</td>
                        <td>@Model.NewRecord[i].Age</td>
                        @* <td>
                            <a asp-page="/Students/Edit"
                            asp-route-id="@Model.NewRecord[i].Id"
                            class="btn btn-primary">
                                Edit
                            </a>
                        </td>
                        <td>
                            <a asp-page="/Students/Delete"
                            asp-route-id="@Model.NewRecord[i].Id"
                            class="btn btn-danger">
                                Delete
                            </a>
                        </td> *@
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-primary dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    Actions
                                </button>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item text-success"
                                        asp-page="/Students/Edit"
                                        asp-route-id="@Model.NewRecord[i].Id">Edit</a>
                                    </li>
                                    @* <li>
                                        <a class="dropdown-item" href="#">Edit</a>
                                    </li> *@
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger"
                                        asp-page="/Students/Delete"
                                        asp-route-id="@Model.NewRecord[i].Id"
                                        >Delete</a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <a href="/Students/Create">Register more student</a>

        @* <a href="/Students/Edit?id=2">Edit a Student</a> *@
    }
    <div class="mt-3">
        <p id="greeting"></p>
    </div>
    <div class="mt-3">
        <input type="text" id="studentName" class="form-control" placeholder="Type to inspect it above">
        @* <button id="greetButton" class="btn btn-primary mt-2">Greet Me</button> *@
    </div>
    @* <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p> *@
</div>

<script type="module" src="~/js/app.js"></script>

