@page
@model IlasanApp.Pages.Forms.RegistrationModel

@{
	ViewData["Title"] = "Student Registration";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-12 col-md-8 col-lg-6">
			<div class="card">
				<div class="card-header">
					<h4 class="mb-0">Register Student</h4>
				</div>
				<div class="card-body">
					<form method="post" class="mt-3">
						<div class="mt-3">
							<label class="form-label" asp-for="Student.FirstName"></label>
							<input class="form-control" asp-for="Student.FirstName" />
							<span class="text-danger small fw-semibold fst-italic" asp-validation-for="Student.FirstName"></span>
						</div>

						<div class="mt-3">
							<label class="form-label" asp-for="Student.LastName"></label>
							<input class="form-control" asp-for="Student.LastName" />
							<span class="text-danger small fw-semibold fst-italic" asp-validation-for="Student.LastName"></span>
						</div>

						<div class="mt-3">
							<label class="form-label" asp-for="Student.Email"></label>
							<input class="form-control" asp-for="Student.Email" />
							<span class="text-danger small fw-semibold fst-italic" asp-validation-for="Student.Email"></span>
						</div>

						<div class="mt-3">
							<label class="form-label" asp-for="Student.Phone"></label>
							<input class="form-control" asp-for="Student.Phone" />
							<span class="text-danger small fw-semibold fst-italic" asp-validation-for="Student.Phone"></span>
						</div>

						<div class="mt-3">
							<label class="form-label" asp-for="Student.Age"></label>
							<input class="form-control" asp-for="Student.Age" />
							<span class="text-danger small fw-semibold fst-italic" asp-validation-for="Student.Age"></span>
						</div>

						<div class="mt-3">
							<label class="form-label" asp-for="Student.Department"></label>
							<input class="form-control" asp-for="Student.Department" />
							<span class="text-danger small fw-semibold fst-italic" asp-validation-for="Student.Department"></span>
						</div>

						<div class="mt-3">
							<button class="btn btn-success" type="submit">Submit</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>