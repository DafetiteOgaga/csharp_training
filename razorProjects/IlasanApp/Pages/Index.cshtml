@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to School</h1>
    @{
        if (Model.StudentRecords.Count == 0) {
            <p>No student registered yet.</p>
        } else {
            <table class="table table-striped table-hover table-sm align-middle">
                <thead>
                    <tr>
                        <th class="index-table-head">S/N</th>
                        <th class="index-table-head">First Name</th>
                        <th class="index-table-head">Age</th>
                        <th class="index-table-head">Phone Number</th>
                        <th class="index-table-head">Dept</th>
                        <th class="index-table-head">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int ind=0;ind<Model.StudentRecords.Count;ind++){
                        <tr>
                            <td>@(ind+1)</td>
                            <td>@Model.StudentRecords[ind].FirstName</td>
                            <td>@Model.StudentRecords[ind].Age</td>
                            <td>@Model.StudentRecords[ind].Phone</td>
                            <td>@Model.StudentRecords[ind].Department</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-primary dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown">
                                        Actions
                                    </button>

                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item text-success"
                                            asp-page="/Forms/Edit"
                                            asp-route-id="@Model.StudentRecords[ind].Id">Edit</a>
                                        </li>
                                        @* <li>
                                            <a class="dropdown-item" href="#">Edit</a>
                                        </li> *@
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-danger"
                                            asp-page="/Forms/Delete"
                                            asp-route-id="@Model.StudentRecords[ind].Id"
                                            >Delete</a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    <a href="/Forms/Registration" class="small fw-semibold fst-italic">Click here to register a student</a>
</div>
<script type="module" src="~/js/app.js"></script>