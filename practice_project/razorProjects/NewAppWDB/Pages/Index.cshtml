@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to</h1>
    <h3>@Model.ApplicationName</h3>
    <p>Total registered students: @Model.NewRecord.Count</p>
    @if (Model.NewRecord.Count == 0) {
        <p>Oopsy! No Student has been registered yet.</p>
        <a href="/Students/Create">Click here to Register a Student</a>
    } else {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>S/N</th>
                    <th>ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Age</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @for (int i=0;i<Model.NewRecord.Count;i++){
                    <tr>
                        <td>@(i+1)</td>
                        <td>@Model.NewRecord[i].Id</td>
                        <td>@Model.NewRecord[i].FirstName</td>
                        <td>@Model.NewRecord[i].LastName</td>
                        <td>@Model.NewRecord[i].Age</td>
                        <td>
                            @* <button class="btn btn-primary" type="button"
                            onclick="window.location.href='/Students/Edit?id=@Model.NewRecord[i].Id'">
                                Edit
                            </button> *@
                            <a asp-page="/Students/Edit"
                            asp-route-id="@Model.NewRecord[i].Id"
                            class="btn btn-primary">
                                Edit
                            </a>
                        </td>
                        <td>
                            <a asp-page="/Students/Delete"
                            asp-route-id="@Model.NewRecord[i].Id"
                            class="btn btn-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <a href="/Students/Create">Register more student</a>

        @* <a href="/Students/Edit?id=2">Edit a Student</a> *@
    }
    @* <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p> *@
</div>
