
@page
@model InterviewLogin.Pages.Login.LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
	<h1>Login here</h1>

	<form method="post">
		<div asp-validation-summary="ModelOnly" class="text-danger"></div>

		<div class="mt-3">
			<label asp-for="LoginProp.Email"
			class="form-label"></label>

			<input asp-for="LoginProp.Email"
			class="form-control" />

			<span asp-validation-for="LoginProp.Email"
			class="text-danger"></span>
		</div>

		<div class="mt-3">
			<label asp-for="LoginProp.Password"
			class="form-label"></label>

			<input asp-for="LoginProp.Password"
			class="form-control" />

			<span asp-validation-for="LoginProp.Password"
			class="text-danger"></span>
		</div>

		<div class="mt-3">
			<button class="btn btn-primary" type="submit">Login</button>
		</div>
	</form>
</div>